# NexTore Designer deployment example (NXD-D35).
# Copy to .env next to compose.yml and fill in the deployment values.

# Image tag built from deploy/nextore/Dockerfile.
DESIGNER_IMAGE=nextore/designer:dev
# Host port published on 127.0.0.1. Put a reverse proxy in front for TLS.
DESIGNER_PORT=7456

# NexTore origin the daemon calls. No path, no credentials.
NEXTORE_BASE_URL=http://nextore.internal:8080
# OAuth client pre-registered for this installation.
NEXTORE_OAUTH_CLIENT_ID=
# Origin users reach this Designer at. Must match the registered redirect.
DESIGNER_BASE_URL=http://designer.internal:7456

# Session secret for cookie signing. Keep outside the repository.
DESIGNER_SECRET_FILE_HOST=./designer_secret

# bwrap (default) or noop. noop is for development hosts only.
DESIGNER_SANDBOX=bwrap
DESIGNER_MEM_LIMIT=1g
# Set when a reverse proxy terminates TLS in front of Designer.
TRUST_PROXY=1
