# NexTore Designer service configuration (NXD-D36).
# Installed to /etc/nextore-designer/designer.env by install.sh.
# Fill in the NexTore values, then: systemctl restart nextore-designer

NODE_ENV=production
OD_EDITION=nextore
OD_BIND_HOST=127.0.0.1
OD_PORT=7456
OD_DATA_DIR=@DATA_DIR@
OD_SANDBOX=bwrap
OD_BWRAP_BIN=/usr/bin/bwrap

# NexTore origin, without a path or credentials.
NEXTORE_BASE_URL=
# OAuth client pre-registered for this installation.
NEXTORE_OAUTH_CLIENT_ID=
# Origin users reach this Designer at; must match the registered redirect.
DESIGNER_BASE_URL=
# Session secret written by install.sh.
DESIGNER_SECRET_FILE=/etc/nextore-designer/designer_secret
# Set to 1 when a reverse proxy terminates TLS in front of Designer.
TRUST_PROXY=
