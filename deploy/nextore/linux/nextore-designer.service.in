[Unit]
Description=NexTore Designer
Documentation=https://github.com/nexu-io/open-design
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@PREFIX@
EnvironmentFile=/etc/nextore-designer/designer.env
ExecStart=/usr/bin/env node @PREFIX@/apps/daemon/dist/cli.js --no-open
Restart=always
RestartSec=3s

# bubblewrap creates user, pid, and mount namespaces and may rely on the
# setuid helper Ubuntu ships. Keep NoNewPrivileges off. Do not add
# seccomp-based directives (SystemCallFilter, RestrictNamespaces,
# RestrictAddressFamilies, RestrictSUIDSGID, LockPersonality, ProtectClock):
# they implicitly enable NoNewPrivileges, which disables the setuid transition
# and makes the runtime probe fail even though a shell probe as the same user
# succeeds. Isolation comes from bwrap itself.
NoNewPrivileges=no
PrivateTmp=yes
# full keeps /usr, /boot and /etc read-only without locking /proc or /sys.
ProtectSystem=full
ProtectHome=yes
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
