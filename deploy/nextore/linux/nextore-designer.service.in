[Unit]
Description=NexTore Designer
Documentation=https://github.com/nexu-io/open-design
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@PREFIX@
EnvironmentFile=/etc/nextore-designer/designer.env
ExecStart=/usr/bin/env node @PREFIX@/apps/daemon/dist/cli.js --no-open
Restart=always
RestartSec=3s

# Hardening. Do not add SystemCallFilter or RestrictNamespaces: bubblewrap
# must call unshare(CLONE_NEWUSER) and mount inside that namespace.
# NoNewPrivileges is explicitly off because Ubuntu ships bwrap as setuid-root;
# NNP suppresses that transition and leaves the AppArmor-restricted
# unprivileged path, which fails at run time even though a shell probe as the
# same user succeeds. Isolation comes from bwrap itself.
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
ReadWritePaths=@DATA_DIR@

[Install]
WantedBy=multi-user.target
